{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 140,
	"singleQuote": false,
	"semi": true,
	"useTabs": true,
	"sortImports": true,
	"sortPackageJson": true,
	"ignorePatterns": [
		// Generated by `wrangler types`: regenerated on every binding change, never hand-format.
		"worker-configuration.d.ts",
		"pnpm-lock.yaml",
		".wrangler/",
		"node_modules/",
		"dist/",
		"coverage/",
	],
}
